<%- include('../partials/header') %>

<div class="d-flex">
  <%- include('../partials/sidebar', { active: 'dashboard' }) %>
  
  <div class="main-content">
    <div class="content-header">
      <h4 class="mb-0">Dashboard</h4>
    </div>
    
    <div class="content-body">
      <%- include('../partials/messages') %>
      
      <% if (isManager) { %>
        <!-- Stats Cards -->
        <div class="row g-4 mb-4">
          <div class="col-md-3">
            <div class="stat-card">
              <div class="stat-value"><%= stats.total %></div>
              <div class="stat-label">Total Posts</div>
            </div>
          </div>
          <div class="col-md-3">
            <div class="stat-card" style="border-left: 4px solid var(--status-pending);">
              <div class="stat-value" style="color: var(--status-pending);"><%= stats.pending %></div>
              <div class="stat-label">Pending Review</div>
            </div>
          </div>
          <div class="col-md-3">
            <div class="stat-card" style="border-left: 4px solid var(--status-approved);">
              <div class="stat-value" style="color: var(--status-approved);"><%= stats.approved %></div>
              <div class="stat-label">Approved</div>
            </div>
          </div>
          <div class="col-md-3">
            <div class="stat-card" style="border-left: 4px solid var(--status-rejected);">
              <div class="stat-value" style="color: var(--status-rejected);"><%= stats.rejected %></div>
              <div class="stat-label">Rejected</div>
            </div>
          </div>
        </div>
      <% } %>
      
      <!-- Posts Section -->
      <div class="card">
        <div class="card-header d-flex align-items-center justify-content-between py-3">
          <h5 class="mb-0"><%= isManager ? 'All Posts' : 'My Posts' %></h5>
          <a href="/posts/create" class="btn btn-primary btn-sm">
            <i class="bi bi-plus me-1"></i>Create Post
          </a>
        </div>
        <div class="card-body p-0">
          <% 
            const pinnedPosts = posts.filter(p => p.isPinned);
            const unpinnedPosts = posts.filter(p => !p.isPinned);
          %>
          
          <% if (posts.length === 0) { %>
            <div class="text-center py-5">
              <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
              <p class="text-muted mt-3 mb-0">No posts yet</p>
            </div>
          <% } else { %>
            <% if (pinnedPosts.length > 0) { %>
              <div class="pinned-section">
                <div class="section-label px-3 py-2 bg-light border-bottom">
                  <i class="bi bi-pin-fill text-warning me-1"></i>
                  <small class="text-muted fw-medium">Pinned Posts</small>
                </div>
                <div id="pinned-posts-list" class="p-3 pb-0">
                  <% pinnedPosts.forEach((post, index) => { %>
                    <%- include('../partials/post-card', { post, isManager }) %>
                  <% }); %>
                </div>
              </div>
            <% } %>
            
            <% if (unpinnedPosts.length > 0) { %>
              <div class="unpinned-section">
                <% if (pinnedPosts.length > 0) { %>
                  <div class="section-label px-3 py-2 bg-light border-bottom border-top">
                    <i class="bi bi-collection text-muted me-1"></i>
                    <small class="text-muted fw-medium">All Posts</small>
                  </div>
                <% } %>
                <div id="unpinned-posts-list" class="p-3">
                  <% unpinnedPosts.forEach((post, index) => { %>
                    <%- include('../partials/post-card', { post, isManager }) %>
                  <% }); %>
                </div>
              </div>
            <% } %>
          <% } %>
        </div>
        
        <%- include('../partials/pagination', { pagination }) %>
      </div>
    </div>
  </div>
</div>

<% if (isManager) { %>
<script>
document.addEventListener('DOMContentLoaded', function() {
  // Initialize sortable for pinned posts
  const pinnedList = document.getElementById('pinned-posts-list');
  if (pinnedList && typeof Sortable !== 'undefined') {
    new Sortable(pinnedList, {
      animation: 150,
      handle: '.drag-handle',
      ghostClass: 'dragging',
      group: 'pinned',
      onEnd: function(evt) {
        saveOrder();
      }
    });
  }
  
  // Initialize sortable for unpinned posts
  const unpinnedList = document.getElementById('unpinned-posts-list');
  if (unpinnedList && typeof Sortable !== 'undefined') {
    new Sortable(unpinnedList, {
      animation: 150,
      handle: '.drag-handle',
      ghostClass: 'dragging',
      group: 'unpinned',
      onEnd: function(evt) {
        saveOrder();
      }
    });
  }
  
  function saveOrder() {
    const order = [];
    let sortIndex = 0;
    
    // Pinned posts first
    if (pinnedList) {
      pinnedList.querySelectorAll('.post-card').forEach(item => {
        order.push({ id: item.dataset.id, sortOrder: sortIndex++ });
      });
    }
    
    // Then unpinned posts
    if (unpinnedList) {
      unpinnedList.querySelectorAll('.post-card').forEach(item => {
        order.push({ id: item.dataset.id, sortOrder: sortIndex++ });
      });
    }
    
    fetch('/api/posts/reorder', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ order })
    }).catch(err => console.error('Error saving order:', err));
  }
});
</script>
<% } %>

<%- include('../partials/footer') %>
