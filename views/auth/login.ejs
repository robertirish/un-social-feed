<%- include('../partials/header') %>

<div class="min-vh-100 d-flex align-items-center justify-content-center" style="background: linear-gradient(135deg, #f5f7fa 0%, #e4e8ec 100%);">
  <div class="card" style="width: 100%; max-width: 400px;">
    <div class="card-body p-4">
      <div class="text-center mb-4">
        <h4 class="mb-1 d-flex align-items-center justify-content-center" style="color: var(--un-blue);">
          <img src="https://upload.wikimedia.org/wikipedia/commons/e/ee/UN_emblem_blue.svg" alt="UN" width="36" height="32" class="me-2">
          UN Social Feed
        </h4>
        <p class="text-muted small">Sign in to your account</p>
      </div>
      
      <%- include('../partials/messages') %>
      
      <form action="/auth/login" method="POST">
        <div class="mb-3">
          <label for="email" class="form-label">Email</label>
          <input type="email" class="form-control" id="email" name="email" required autofocus>
        </div>
        
        <div class="mb-3">
          <label for="password" class="form-label">Password</label>
          <input type="password" class="form-control" id="password" name="password" required>
        </div>
        
        <button type="submit" class="btn btn-primary w-100">Sign In</button>
      </form>
      
      <div class="text-center mt-3">
        <span class="text-muted">Don't have an account?</span>
        <a href="/auth/register">Register</a>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
