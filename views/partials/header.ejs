<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title><%= typeof title !== 'undefined' ? title + ' | ' : '' %>UN Social Feed</title>

  <!-- Favicon - UN Emblem -->
  <link rel="icon" type="image/svg+xml" href="https://upload.wikimedia.org/wikipedia/commons/e/ee/UN_emblem_blue.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="https://upload.wikimedia.org/wikipedia/commons/thumb/e/ee/UN_emblem_blue.svg/32px-UN_emblem_blue.svg.png">
  <link rel="apple-touch-icon" href="https://upload.wikimedia.org/wikipedia/commons/thumb/e/ee/UN_emblem_blue.svg/180px-UN_emblem_blue.svg.png">

  <!-- Google Fonts - Roboto + Roboto Condensed -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Roboto+Condensed:wght@400;600;700&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">

  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.min.css">

  <!-- Quill Editor CSS -->
  <link href="https://cdn.jsdelivr.net/npm/quill@2.0.0-rc.2/dist/quill.snow.css" rel="stylesheet">

  <!-- Admin CSS -->
  <link rel="stylesheet" href="/css/admin.css">

  <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
  <meta name="csrf-token" content="<%= csrfToken %>">
  <% } %>
</head>
<body>
  <header class="admin-header">
    <a href="/admin" class="admin-logo">
      <img src="https://upload.wikimedia.org/wikipedia/commons/e/ee/UN_emblem_blue.svg" alt="UN" class="admin-logo-icon">
      UN Social Feed
    </a>
    <nav class="admin-nav">
      <a href="/admin">Dashboard</a>
      <a href="/posts/create">Create Post</a>
      <% if (typeof user !== 'undefined' && user && ['editor', 'admin'].includes(user.role)) { %>
        <a href="/admin/posts/all">All Posts</a>
        <a href="/admin/posts/pending">Pending<% if (typeof postCounts !== 'undefined' && postCounts && postCounts.pending > 0) { %><span class="pending-count"><%= postCounts.pending %></span><% } %></a>
        <a href="/embed/code">Embed</a>
      <% } %>
      <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
        <a href="/admin/users">Users</a>
      <% } %>
      <span class="admin-sep">|</span>
      <a href="/admin/account">Account</a>
      <a href="/auth/logout">Logout</a>
    </nav>
  </header>

  <main class="admin-main">
    <%- include('messages') %>
