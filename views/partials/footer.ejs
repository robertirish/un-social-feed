  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  
  <!-- Quill Editor -->
  <script src="https://cdn.jsdelivr.net/npm/quill@2.0.0-rc.2/dist/quill.js"></script>
  
  <!-- SortableJS for drag and drop -->
  <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
  
  <script>
    (function() {
      var meta = document.querySelector('meta[name="csrf-token"]');
      if (!meta) return;
      var csrfToken = meta.getAttribute('content');

      function injectToken(form) {
        if (form.method && form.method.toUpperCase() === 'POST' && !form.querySelector('input[name="_csrf"]')) {
          var input = document.createElement('input');
          input.type = 'hidden';
          input.name = '_csrf';
          input.value = csrfToken;
          form.appendChild(input);
        }
      }

      document.querySelectorAll('form').forEach(injectToken);

      document.addEventListener('submit', function(e) {
        if (e.target.tagName === 'FORM') injectToken(e.target);
      }, true);

      var originalFetch = window.fetch;
      window.fetch = function(url, options) {
        options = options || {};
        if (options.method && options.method.toUpperCase() !== 'GET') {
          options.headers = options.headers || {};
          if (options.headers instanceof Headers) {
            options.headers.set('X-CSRF-Token', csrfToken);
          } else {
            options.headers['X-CSRF-Token'] = csrfToken;
          }
        }
        return originalFetch.call(this, url, options);
      };
    })();
  </script>

  <script>
    // Flash message auto-dismiss
    document.querySelectorAll('.alert-dismissible').forEach(alert => {
      setTimeout(() => {
        alert.classList.remove('show');
        setTimeout(() => alert.remove(), 300);
      }, 5000);
    });
  </script>
</body>
</html>
