<div class="sidebar d-flex flex-column">
  <div class="sidebar-brand d-flex align-items-center">
    <img src="https://upload.wikimedia.org/wikipedia/commons/e/ee/UN_emblem_blue.svg" alt="UN" width="28" height="24" class="me-2" style="flex-shrink: 0;">
    <span style="line-height: 1; padding-top: 2px;">UN Social Feed</span>
  </div>
  
  <nav class="sidebar-nav flex-grow-1">
    <a href="/admin" class="nav-link <%= typeof active !== 'undefined' && active === 'dashboard' ? 'active' : '' %>">
      <i class="bi bi-house"></i> Dashboard
    </a>
    
    <a href="/posts/create" class="nav-link <%= typeof active !== 'undefined' && active === 'create' ? 'active' : '' %>">
      <i class="bi bi-plus-circle"></i> Create Post
    </a>
    
    <% if (user && ['editor', 'admin'].includes(user.role)) { %>
      <div class="sidebar-section">Content</div>
      
      <a href="/admin/posts/all" class="nav-link <%= typeof active !== 'undefined' && active === 'all' ? 'active' : '' %>">
        <i class="bi bi-collection"></i> All Posts
        <% if (postCounts) { %>
          <span class="count-badge">(<%= postCounts.total %>)</span>
        <% } %>
      </a>
      
      <a href="/admin/posts/pending" class="nav-link <%= typeof active !== 'undefined' && active === 'pending' ? 'active' : '' %> <%= postCounts && postCounts.pending > 0 ? 'has-pending' : '' %>">
        <i class="bi bi-clock"></i> Pending Review
        <% if (postCounts) { %>
          <% if (postCounts.pending > 0) { %>
            <span class="count-badge pending-count"><%= postCounts.pending %></span>
          <% } else { %>
            <span class="count-badge">(0)</span>
          <% } %>
        <% } %>
      </a>
      
      <a href="/admin/posts/approved" class="nav-link <%= typeof active !== 'undefined' && active === 'approved' ? 'active' : '' %>">
        <i class="bi bi-check-circle"></i> Approved
        <% if (postCounts) { %>
          <span class="count-badge">(<%= postCounts.approved %>)</span>
        <% } %>
      </a>
      
      <a href="/admin/posts/rejected" class="nav-link <%= typeof active !== 'undefined' && active === 'rejected' ? 'active' : '' %>">
        <i class="bi bi-x-circle"></i> Rejected
        <% if (postCounts) { %>
          <span class="count-badge">(<%= postCounts.rejected %>)</span>
        <% } %>
      </a>
      
      <div class="sidebar-section">Embed</div>
      
      <a href="/embed/code" class="nav-link <%= typeof active !== 'undefined' && active === 'embed' ? 'active' : '' %>">
        <i class="bi bi-code-slash"></i> Embed Code
      </a>
      
      <a href="/embed" target="_blank" class="nav-link">
        <i class="bi bi-box-arrow-up-right"></i> Preview Carousel
      </a>
      
      <a href="/embed/classic" target="_blank" class="nav-link">
        <i class="bi bi-box-arrow-up-right"></i> Preview Classic
      </a>
    <% } %>
    
    <% if (user && user.role === 'admin') { %>
      <div class="sidebar-section">Administration</div>
      
      <a href="/admin/users" class="nav-link <%= typeof active !== 'undefined' && active === 'users' ? 'active' : '' %>">
        <i class="bi bi-people"></i> Users
      </a>
    <% } %>
    
    <div class="sidebar-section">Settings</div>
    
    <a href="/admin/account" class="nav-link <%= typeof active !== 'undefined' && active === 'account' ? 'active' : '' %>">
      <i class="bi bi-person-gear"></i> Account
    </a>
  </nav>
  
  <!-- User info and logout at bottom -->
  <div class="sidebar-footer">
    <div class="sidebar-user d-flex align-items-center justify-content-between">
      <div class="d-flex align-items-center">
        <div class="user-avatar me-2">
          <%= user ? user.name.charAt(0).toUpperCase() : '?' %>
        </div>
        <div>
          <div class="small fw-medium"><%= user ? user.name : 'Guest' %></div>
          <div class="small text-muted text-capitalize"><%= user ? user.role : '' %></div>
        </div>
      </div>
      <a href="/auth/logout" class="btn btn-sm btn-outline-secondary" title="Logout">
        <i class="bi bi-box-arrow-right"></i>
      </a>
    </div>
  </div>
</div>

<style>
  .sidebar-footer {
    border-top: 1px solid var(--border-color);
    margin-top: auto;
  }
  
  .sidebar-user {
    padding: 0.75rem 1rem;
    background: var(--bg-light);
  }
  
  .sidebar-nav .count-badge {
    color: #999;
    font-size: 0.8em;
    margin-left: auto;
  }
  
  .sidebar-nav .pending-count {
    background: var(--status-pending);
    color: #fff;
    padding: 0.15rem 0.5rem;
    border-radius: 10px;
    font-size: 0.75rem;
    font-weight: 600;
    animation: pulse-pending 2s infinite;
  }
  
  .sidebar-nav .nav-link.has-pending {
    font-weight: 500;
    color: #333;
  }
  
  .sidebar-nav .nav-link.has-pending i {
    color: var(--status-pending);
  }
  
  @keyframes pulse-pending {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.7;
    }
  }
</style>
