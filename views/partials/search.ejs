<form method="GET" class="d-flex align-items-center gap-2" style="flex-wrap: nowrap;">
  <div class="input-group input-group-sm" style="width: 250px; flex-shrink: 0;">
    <input type="text" class="form-control" name="search" placeholder="<%= placeholder || 'Search...' %>" value="<%= search || '' %>">
    <button type="submit" class="btn btn-outline-secondary">
      <i class="bi bi-search"></i>
    </button>
  </div>
  <% if (search) { %>
    <a href="<%= clearUrl || '?' %>" class="btn btn-sm btn-outline-secondary d-flex align-items-center" style="white-space: nowrap; height: 31px;">
      <i class="bi bi-x-lg me-1"></i> Clear
    </a>
  <% } %>
</form>
