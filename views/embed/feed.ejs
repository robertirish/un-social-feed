<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>UN Social Feed</title>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700&display=swap');

    *, *::before, *::after {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html, body {
      height: 85vh;
      overflow: hidden;
      font-family: 'Open Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      background: #fff;
      color: #333;
    }

    /* ── Scroll wrapper ─────────────────────────────── */

    .scroll-wrapper {
      height: 85vh;
      overflow: hidden;
      padding: 0.5rem;
    }

    .scroll-track {
      display: flex;
      gap: 0.5rem;
      height: 100%;
      width: max-content;
      will-change: transform;
    }

    .scroll-track.animate {
      animation: scroll-left var(--duration, 60s) linear infinite;
    }

    .scroll-wrapper:hover .scroll-track.animate {
      animation-play-state: paused;
    }

    @keyframes scroll-left {
      from { transform: translateX(0); }
      to   { transform: translateX(-50%); }
    }

    /* ── Column (top-to-bottom, then next column) ──── */

    .scroll-column {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      flex-shrink: 0;
      height: 100%;
    }

    /* ── Card ────────────────────────────────────────── */

    .feed-card {
      position: relative;
      width: 300px;
      border-radius: 10px;
      overflow: hidden;
      background: #f0f0f0;
      flex-shrink: 0;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }

    /* Full-bleed media layer */
    .feed-card-media {
      position: absolute;
      inset: 0;
    }

    .feed-card-media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    /* YouTube play icon (always visible on video cards) */
    .play-icon {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 52px;
      height: 52px;
      background: rgba(0, 0, 0, 0.65);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 2;
      pointer-events: none;
      transition: background 0.2s;
    }

    .feed-card:hover .play-icon {
      background: rgba(255, 0, 0, 0.85);
    }

    .play-icon::after {
      content: '';
      display: block;
      width: 0;
      height: 0;
      border-style: solid;
      border-width: 9px 0 9px 16px;
      border-color: transparent transparent transparent #fff;
      margin-left: 3px;
    }

    /* Hover overlay */
    .feed-card-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.4) 50%, rgba(0,0,0,0.1) 100%);
      opacity: 0;
      transition: opacity 0.3s ease;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: 1rem;
      z-index: 5;
      pointer-events: none;
    }

    .feed-card:hover .feed-card-overlay {
      opacity: 1;
    }

    .feed-card-title {
      font-size: 0.95rem;
      font-weight: 600;
      color: #fff;
      line-height: 1.35;
      margin-bottom: 0.3rem;
    }

    .feed-card-title a {
      color: inherit;
      text-decoration: none;
      pointer-events: auto;
    }

    .feed-card-title a:hover {
      color: #009EDB;
    }

    .feed-card-content {
      font-size: 0.78rem;
      color: rgba(255, 255, 255, 0.8);
      max-height: 3.2em;
      overflow: hidden;
      line-height: 1.4;
    }

    .feed-card-content p {
      margin: 0;
    }

    /* Invisible full-card link */
    .feed-card-link {
      position: absolute;
      inset: 0;
      z-index: 4;
    }

    /* No-media cards (text-only originals) */
    .feed-card.no-media {
      background: linear-gradient(135deg, #009EDB 0%, #005B8E 100%);
    }

    .feed-card.no-media .feed-card-overlay {
      opacity: 1;
      background: none;
      justify-content: center;
      align-items: center;
      text-align: center;
    }

    .feed-card.no-media .feed-card-title {
      font-size: 1.1rem;
    }

    /* Source type badge */
    .source-badge {
      position: absolute;
      top: 0.6rem;
      left: 0.6rem;
      background: rgba(0, 0, 0, 0.55);
      color: #fff;
      font-size: 0.7rem;
      font-weight: 600;
      padding: 0.2rem 0.5rem;
      border-radius: 4px;
      z-index: 2;
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      display: flex;
      align-items: center;
      gap: 0.3rem;
    }

    .source-badge svg {
      width: 12px;
      height: 12px;
      fill: currentColor;
    }

    /* ── Empty state ────────────────────────────────── */

    .empty-state {
      height: 85vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      color: #999;
    }

    .empty-state svg {
      width: 64px;
      height: 64px;
      margin-bottom: 1rem;
      opacity: 0.3;
    }

    .empty-state p {
      font-size: 0.9rem;
    }

    /* ── Responsive ─────────────────────────────────── */

    @media (max-height: 500px) {
      .feed-card {
        width: 240px;
      }
    }

    @media (max-height: 360px) {
      .scroll-column {
        flex-direction: row;
      }
      .feed-card {
        height: calc(85vh - 1rem) !important;
        width: 260px;
      }
    }
  </style>
</head>
<body>
  <% if (posts.length === 0) { %>
    <div class="empty-state">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
      </svg>
      <p>No posts available</p>
    </div>
  <% } else { %>
    <%
      const ROWS = 2;
      const columns = [];
      for (let i = 0; i < posts.length; i += ROWS) {
        columns.push(posts.slice(i, i + ROWS));
      }
      const heightPatterns = [
        [0.58, 0.42], [0.40, 0.60], [0.52, 0.48],
        [0.63, 0.37], [0.45, 0.55], [0.55, 0.45],
        [0.38, 0.62], [0.60, 0.40], [0.50, 0.50],
        [0.42, 0.58], [0.62, 0.38], [0.48, 0.52],
      ];
    %>
    <div class="scroll-wrapper">
      <div class="scroll-track" id="scrollTrack">
        <% for (let copy = 0; copy < 2; copy++) { %>
          <% columns.forEach((col, colIdx) => { %>
            <%
              const pattern = heightPatterns[colIdx % heightPatterns.length];
            %>
            <div class="scroll-column">
              <% col.forEach((post, rowIdx) => { %>
                <%
                  const cardLink = post.linkUrl
                    || (post.sourceType !== 'original' && post.sourceUrl ? post.sourceUrl : null);
                  const imgSrc = post.imageUrl
                    ? (post.imageUrl.startsWith('/') ? baseUrl + post.imageUrl : post.imageUrl)
                    : null;
                  const isYouTube = post.sourceType === 'youtube' && post.sourceId;
                  const hasMedia = !!(imgSrc || isYouTube);
                  const ratio = col.length === 1 ? 1 : pattern[rowIdx];
                  const heightCalc = col.length === 1
                    ? 'calc(85vh - 1rem)'
                    : 'calc(' + ratio + ' * (85vh - 1.5rem))';
                %>
                <div class="feed-card<%= hasMedia ? '' : ' no-media' %>" style="height:<%= heightCalc %>">
                  <% if (hasMedia) { %>
                    <div class="feed-card-media">
                      <img
                        src="<%= imgSrc || ('https://img.youtube.com/vi/' + post.sourceId + '/hqdefault.jpg') %>"
                        alt="<%= post.title %>"
                        loading="lazy"
                      >
                    </div>
                    <% if (isYouTube) { %>
                      <div class="play-icon"></div>
                    <% } %>
                  <% } %>

                  <div class="feed-card-overlay">
                    <h3 class="feed-card-title"><% if (cardLink) { %><a href="<%= cardLink %>" target="_blank" rel="noopener noreferrer"><%= post.title %></a><% } else { %><%= post.title %><% } %></h3>
                    <% if (post.content && post.content !== '<p><br></p>') { %>
                      <div class="feed-card-content"><%- post.content %></div>
                    <% } %>
                  </div>

                  <% if (cardLink) { %>
                    <a href="<%= cardLink %>" target="_blank" rel="noopener noreferrer" class="feed-card-link" aria-label="<%= post.title %>"></a>
                  <% } %>
                </div>
              <% }); %>
            </div>
          <% }); %>
        <% } %>
      </div>
    </div>
  <% } %>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      var track = document.getElementById('scrollTrack');
      if (!track) return;

      var images = track.querySelectorAll('.feed-card-media img');
      var loaded = 0;
      var total = images.length;

      function startScroll() {
        var contentWidth = track.scrollWidth / 2;
        var viewportWidth = track.parentElement.offsetWidth;

        if (contentWidth <= viewportWidth) return;

        var speed = 40;
        var duration = contentWidth / speed;
        track.style.setProperty('--duration', duration + 's');
        track.classList.add('animate');
      }

      function onImageReady() {
        loaded++;
        if (loaded >= total) startScroll();
      }

      if (total === 0) {
        startScroll();
      } else {
        images.forEach(function(img) {
          if (img.complete) {
            onImageReady();
          } else {
            img.addEventListener('load', onImageReady);
            img.addEventListener('error', onImageReady);
          }
        });
        setTimeout(startScroll, 3000);
      }
    });
  </script>
</body>
</html>
